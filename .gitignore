# ── Binaries ─────────────────────────────────────────────────────────────────
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
**.o 

# Project-specific binaries (built by make)
workspace/release/
workspace/daemon/vajra

# ── Go ────────────────────────────────────────────────────────────────────────
*.out
coverage.*
*.coverprofile
profile.cov

# Go workspace lock (workspace file itself is committed)
go.work.sum

# ── eBPF generated objects ────────────────────────────────────────────────────
# .go and .o files are regenerated by `make generate-ebpf`.
# Commit them so developers without a full BPF toolchain can still build.
# Uncomment the lines below only if you want to force regeneration on every clone.
# daemon/internal/ebpf/bpf_x86_bpfel.go
# daemon/internal/ebpf/bpf_x86_bpfel.o
# daemon/internal/ebpf/bpf_arm64_bpfel.go
# daemon/internal/ebpf/bpf_arm64_bpfel.o

# ── UI / frontend ─────────────────────────────────────────────────────────────
workspace/ui/build/
workspace/ui/frontend/node_modules/
workspace/ui/frontend/dist/
# Wails generates these from the Go binary at dev time — do not commit.
workspace/ui/frontend/wailsjs/

# ── Runtime data ──────────────────────────────────────────────────────────────
*.db
*.db-shm
*.db-wal
workspace/work_deb_skel/
*.zip

# ── Debian packaging scratch dirs ─────────────────────────────────────────────
# Versioned deb staging trees created by `make _deb` (e.g. vajra_0.0.2_amd64/)
vajra_*/

# ── Secrets / env ─────────────────────────────────────────────────────────────
.env
*.pem
*.key
*.crt

# ── Editor / IDE ──────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*~
.DS_Store
